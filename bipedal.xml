<mujoco model="box_biped">
  <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>
  <option integrator="RK4" timestep="0.005"/>
  <default>
    <joint armature="0.01" damping="1.0" limited="true"/>
    <geom contype="1" conaffinity="0" condim="3" friction="1.0 0.1 0.1" rgba="0.8 0.6 0.4 1"/>
    <motor gear="15" ctrlrange="-1 1"/>
  </default>
  <worldbody>
    <camera name="track" mode="trackcom" pos="0 -3 0.8" xyaxes="1 0 0 0 0.3 1"/>
    <light cutoff="100" diffuse="1 1 1" dir="0 0 -1" directional="true" pos="0 0 2.5"/>
    <geom name="floor" contype="1" conaffinity="1" pos="0 0 0" size="0 0 .25" type="plane" rgba="0.3 0.5 0.3 1"/>

    <body name="torso" pos="0 0 0.95">
      <joint name="root" type="free" limited="false" armature="0" damping="0"/>
      <geom name="torso_geom" type="box" size="0.07 0.07 0.15" pos="0 0 0" rgba="0.2 0.4 0.6 1"/>

      <body name="right_thigh" pos="0 -0.1 -0.15">
        <joint name="right_hip_x" type="hinge" axis="1 0 0" range="-20 20"/>
        <joint name="right_hip_y" type="hinge" axis="0 1 0" range="-45 45"/>
        <geom name="right_thigh_geom" type="box" size="0.045 0.045 0.15" pos="0 0 -0.15"/>
        <body name="right_shin" pos="0 0 -0.3">
          <joint name="right_knee" type="hinge" axis="0 1 0" range="-80 0"/>
          <geom name="right_shin_geom" type="box" size="0.035 0.035 0.125" pos="0 0 -0.125"/>
          <body name="right_foot" pos="0 0 -0.25">
            <joint name="right_ankle" type="hinge" axis="0 1 0" range="-20 20"/>
            <geom name="right_foot_geom" type="box" size="0.07 0.035 0.015" pos="0.03 0 -0.01"/>
          </body>
        </body>
      </body>

      <body name="left_thigh" pos="0 0.1 -0.15">
        <joint name="left_hip_x" type="hinge" axis="1 0 0" range="-20 20"/>
        <joint name="left_hip_y" type="hinge" axis="0 1 0" range="-45 45"/>
        <geom name="left_thigh_geom" type="box" size="0.045 0.045 0.15" pos="0 0 -0.15"/>
        <body name="left_shin" pos="0 0 -0.3">
          <joint name="left_knee" type="hinge" axis="0 1 0" range="-80 0"/>
          <geom name="left_shin_geom" type="box" size="0.035 0.035 0.125" pos="0 0 -0.125"/>
          <body name="left_foot" pos="0 0 -0.25">
            <joint name="left_ankle" type="hinge" axis="0 1 0" range="-20 20"/>
            <geom name="left_foot_geom" type="box" size="0.07 0.035 0.015" pos="0.03 0 -0.01"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor joint="right_hip_x" name="right_hip_x"/>
    <motor joint="right_hip_y" name="right_hip_y"/>
    <motor joint="right_knee" name="right_knee"/>
    <motor joint="right_ankle" name="right_ankle"/>
    <motor joint="left_hip_x" name="left_hip_x"/>
    <motor joint="left_hip_y" name="left_hip_y"/>
    <motor joint="left_knee" name="left_knee"/>
    <motor joint="left_ankle" name="left_ankle"/>
  </actuator>
</mujoco>